# Variables locales (copia a `.env`, nunca se commitea)
# Servidor local server.js (Gmail SMTP):
GMAIL_USER=tu-email@gmail.com
GMAIL_APP_PASSWORD=tu-password-de-aplicacion-de-16-caracteres

# Cloudflare Pages Function (producción, API Resend):
# https://resend.com → API Keys. CONTACT_FROM necesita dominio verificado;
# sin verificar usa onboarding@resend.dev (solo para probar).
RESEND_API_KEY=re_tu_clave
CONTACT_TO=andreumatic@gmail.com
CONTACT_FROM=onboarding@resend.dev
