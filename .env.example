# Variables locales (copia a `.env`, nunca se commitea)
# Servidor local server.js (Gmail SMTP):
GMAIL_USER=tu-email@gmail.com
GMAIL_APP_PASSWORD=tu-password-de-aplicacion-de-16-caracteres

# Cloudflare Pages Function (producción, API Resend):
# https://resend.com → API Keys. CONTACT_FROM necesita dominio verificado;
# sin verificar usa onboarding@resend.dev (solo para probar).
RESEND_API_KEY=re_tu_clave
CONTACT_TO=info@andreumatic.com
CONTACT_FROM=onboarding@resend.dev

# Anti-spam Cloudflare Turnstile (Cloudflare Dashboard > Turnstile > Add widget, modo Managed):
# La SITE_KEY es pública y va en index.html (data-sitekey). La SECRET solo en servidor.
# En Pages > Settings > Environment variables: TURNSTILE_SECRET_KEY
# En local: copia a `.dev.vars` para `wrangler pages dev` y a `.env` para `node server.js`.
TURNSTILE_SITE_KEY=0x4AAAAAA_tu_site_key
TURNSTILE_SECRET_KEY=0x4AAAAAA_tu_secret_key

# Verificación de teléfonos (Veriphone, 1000 gratis/mes, sin tarjeta):
# Pages > Settings > Environment variables: VERIPHONE_API_KEY
VERIPHONE_API_KEY=tu_clave_veriphone
